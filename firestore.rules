rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Allow the specific user email or if there is an admin document.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "hsalyer@tartanbuildersinc.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'address', 'claimFiled', 'approved', 'createdAt', 'status']) &&
             data.keys().size() == 7 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 200 &&
             data.claimFiled is string && data.claimFiled.matches('^(yes|no)$') &&
             data.approved is string && data.approved.matches('^(yes|no|idk|n/a)$') &&
             data.createdAt == request.time &&
             data.status is string && data.status.matches('^(new|contacted|closed)$');
    }

    match /admins/{userId} {
      // Only admins can read/write admins
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false; // Add manually or via admin sdk
      allow update: if false;
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      
      // Anonymous users can create leads
      allow create: if isValidId(leadId) && isValidLead(incoming());
      
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status is string && 
                    incoming().status.matches('^(new|contacted|closed)$') &&
                    incoming().name == existing().name &&
                    incoming().phone == existing().phone &&
                    incoming().address == existing().address &&
                    incoming().claimFiled == existing().claimFiled &&
                    incoming().approved == existing().approved &&
                    incoming().createdAt == existing().createdAt;
                    
      allow delete: if isAdmin();
    }
  }
}
